# Austin Sleep & Airway Health environment configuration.
# Copy to .env.local and fill in the values you have. Every quiz destination
# skips cleanly when its variables are unset, so nothing breaks while these are
# still empty.

# Reserved for the future BAA covered patient data store. Unused in the interim.
# No database is wired up yet, this is a documented interim decision.
# DATABASE_URL=

# Resend transactional email. Powers the internal notification and the patient copy.
RESEND_API_KEY=

# Practice inbox for internal quiz notifications, including per question answers.
PRACTICE_NOTIFY_EMAIL=hello@austinsleephealth.com

# Marketing tool webhook. Receives contact fields, quiz slug, and score band only, never raw answers.
MARKETING_WEBHOOK_URL=

# GA4 Measurement Protocol, server side QuizComplete event. Carries only the quiz slug and a hashed email.
NEXT_PUBLIC_GA4_ID=
GA4_API_SECRET=

# Meta Conversions API, server side QuizComplete event. Carries only the quiz slug and a hashed email.
META_PIXEL_ID=
META_CAPI_ACCESS_TOKEN=

# Public booking link used by scheduling CTAs across the site.
NEXT_PUBLIC_BOOKING_URL=

# Meta pixel id for the client side base code. Loads only on allowed marketing routes, never on any sleep apnea test route.
NEXT_PUBLIC_META_PIXEL_ID=
